---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, siblings: topics.filter((t) => t.id !== entry.id && t.data.strand === entry.data.strand) },
  }));
}

const { entry, siblings } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title} — WAGademy`} description={d.blurb}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Topic · {d.strand}</p>
      <h1>{d.title}</h1>
      <p>{d.subtitle}</p>
      <p class="meta">
        <span class={`badge ${d.kind === 'hands-on' ? 'hands-on' : ''}`}>
          {d.kind === 'hands-on' ? 'Hands-on' : 'Read + do'}
        </span>
        &nbsp;about {d.minutes} minutes
      </p>
    </div>
  </section>

  <div class="wrap">
    <article class="prose">
      <Content />

      {d.slides && (
        <p style="margin-top:2.5rem">
          <a class="btn ghost" href={`/slides/${d.slides}`} download>Download the slides (.pptx)</a>
        </p>
      )}

      <nav class="pager">
        <span>
          {siblings.length > 0 && (
            <>Also in {d.strand}: {siblings.map((s, i) => (
              <>{i > 0 && ' · '}<a href={`/topics/${s.id}/`}>{s.data.title}</a></>
            ))}</>
          )}
        </span>
        <span><a href="/topics/">All topics →</a></span>
      </nav>
    </article>
  </div>
</Base>
